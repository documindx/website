---
import { getLocaleFromUrl, useTranslations } from '../i18n/utils'
const locale = getLocaleFromUrl(Astro.url)
const t = useTranslations(locale)

const rows = [
  { label: t('compare.row.scan'), traditional: true, search: false, ours: true },
  { label: t('compare.row.ocr'), traditional: true, search: true, ours: true },
  { label: t('compare.row.classify'), traditional: false, search: false, ours: true },
  { label: t('compare.row.semantic'), traditional: false, search: 'partial' as const, ours: true },
  { label: t('compare.row.qa'), traditional: false, search: false, ours: true },
  { label: t('compare.row.source'), traditional: false, search: false, ours: true },
  { label: t('compare.row.briefing'), traditional: false, search: false, ours: true },
]
---

<section class="py-24 sm:py-32 bg-gray-50/50 dark:bg-gray-900/50">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold reveal">{t('compare.title')}</h2>
      <p class="mt-4 text-gray-500 dark:text-gray-400">{t('compare.subtitle')}</p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200 dark:border-gray-800">
            <th class="text-left py-4 pr-4 font-medium text-gray-500 dark:text-gray-400"></th>
            <th class="py-4 px-4 font-medium text-gray-500 dark:text-gray-400 text-center">{t('compare.col.traditional')}</th>
            <th class="py-4 px-4 font-medium text-gray-500 dark:text-gray-400 text-center">{t('compare.col.search')}</th>
            <th class="py-4 px-4 font-semibold text-center">
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400">DocuMind</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map(row => (
            <tr class="border-b border-gray-100 dark:border-gray-800/50">
              <td class="py-3.5 pr-4 font-medium">{row.label}</td>
              <td class="py-3.5 px-4 text-center">
                {row.traditional ? <span class="text-gray-400">&#10003;</span> : <span class="text-gray-300 dark:text-gray-700">—</span>}
              </td>
              <td class="py-3.5 px-4 text-center">
                {row.search === true ? <span class="text-gray-400">&#10003;</span> : row.search === 'partial' ? <span class="text-gray-400 text-xs">{t('compare.partial')}</span> : <span class="text-gray-300 dark:text-gray-700">—</span>}
              </td>
              <td class="py-3.5 px-4 text-center">
                {row.ours ? <span class="text-green-500 font-bold">&#10003;</span> : <span class="text-gray-300 dark:text-gray-700">—</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
