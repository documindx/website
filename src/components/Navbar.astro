---
import { getLocaleFromUrl, useTranslations, getLocalePath } from '../i18n/utils'
import { languages } from '../i18n/translations'

const locale = getLocaleFromUrl(Astro.url)
const t = useTranslations(locale)
const otherLocale = locale === 'zh' ? 'en' : 'zh'
const switchPath = getLocalePath(Astro.url.pathname, otherLocale)
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href={locale === 'zh' ? '/' : '/en'} class="flex items-center gap-2 text-lg font-semibold">
      <img src="/icon.png" alt="DocuMindX" class="w-8 h-8 rounded-lg" />
      <span>DocuMindX</span>
    </a>

    <div class="hidden md:flex items-center gap-8 text-sm">
      <a href="#features" class="nav-link opacity-70 hover:opacity-100 transition-opacity">{t('nav.features')}</a>
      <a href="#pricing" class="nav-link opacity-70 hover:opacity-100 transition-opacity">{t('nav.pricing')}</a>
      <a href="#faq" class="nav-link opacity-70 hover:opacity-100 transition-opacity">{t('nav.help')}</a>
    </div>

    <div class="flex items-center gap-3">
      <!-- 主题切换 -->
      <button
        id="theme-toggle"
        class="p-2 opacity-60 hover:opacity-100 transition-opacity rounded-lg hover:bg-gray-100 dark:hover:bg-white/10"
        aria-label="Toggle theme"
      >
        <!-- 太阳（暗色模式下显示，点击切换到亮色） -->
        <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <!-- 月亮（亮色模式下显示，点击切换到暗色） -->
        <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>

      <!-- 语言切换：点击前写 cookie，中间件下次访问不再重定向 -->
      <a
        href={switchPath}
        data-lang={otherLocale}
        class="lang-switch text-xs opacity-60 hover:opacity-100 transition-opacity px-2 py-1 rounded border border-gray-300/30 dark:border-white/10"
      >
        {languages[otherLocale]}
      </a>

      <button
        id="menu-toggle"
        class="md:hidden p-2 -mr-2 opacity-70 hover:opacity-100"
        aria-label={t('nav.menu')}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-white/10 bg-white/80 dark:bg-gray-950/80 backdrop-blur-xl">
    <div class="px-6 py-4 flex flex-col gap-3 text-sm">
      <a href="#features" class="py-2 opacity-70 hover:opacity-100">{t('nav.features')}</a>
      <a href="#pricing" class="py-2 opacity-70 hover:opacity-100">{t('nav.pricing')}</a>
      <a href="#faq" class="py-2 opacity-70 hover:opacity-100">{t('nav.help')}</a>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar')!
  const menuToggle = document.getElementById('menu-toggle')!
  const mobileMenu = document.getElementById('mobile-menu')!
  let lastScrollY = 0
  let ticking = false

  function updateNavbar() {
    const scrollY = window.scrollY
    if (scrollY > 50) {
      navbar.classList.add('bg-white/80', 'dark:bg-gray-950/80', 'backdrop-blur-xl', 'border-b', 'border-gray-200/20', 'dark:border-white/10')
    } else {
      navbar.classList.remove('bg-white/80', 'dark:bg-gray-950/80', 'backdrop-blur-xl', 'border-b', 'border-gray-200/20', 'dark:border-white/10')
    }
    if (scrollY > 300) {
      navbar.style.transform = scrollY > lastScrollY ? 'translateY(-100%)' : 'translateY(0)'
    } else {
      navbar.style.transform = 'translateY(0)'
    }
    lastScrollY = scrollY
    ticking = false
  }

  window.addEventListener('scroll', () => {
    if (!ticking) { requestAnimationFrame(updateNavbar); ticking = true }
  })

  menuToggle.addEventListener('click', () => mobileMenu.classList.toggle('hidden'))
  mobileMenu.querySelectorAll('a').forEach(link =>
    link.addEventListener('click', () => mobileMenu.classList.add('hidden'))
  )

  // 主题切换
  const themeToggle = document.getElementById('theme-toggle')!
  function getTheme(): 'light' | 'dark' {
    const stored = localStorage.getItem('theme')
    if (stored === 'light' || stored === 'dark') return stored
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
  }
  function applyTheme(theme: 'light' | 'dark') {
    document.documentElement.classList.toggle('dark', theme === 'dark')
    localStorage.setItem('theme', theme)
  }
  // 初始化
  applyTheme(getTheme())
  themeToggle.addEventListener('click', () => {
    applyTheme(getTheme() === 'dark' ? 'light' : 'dark')
  })

  // 语言切换：点击时先写 cookie，让 middleware 尊重用户选择
  document.querySelectorAll<HTMLAnchorElement>('a.lang-switch').forEach(link => {
    link.addEventListener('click', () => {
      const target = link.dataset.lang
      if (target === 'zh' || target === 'en') {
        document.cookie = `lang=${target}; Path=/; Max-Age=${60 * 60 * 24 * 365}; SameSite=Lax`
      }
    })
  })
</script>
