---
import { getLocaleFromUrl, useTranslations, getLocalePath } from '../i18n/utils'
import { languages } from '../i18n/translations'

const locale = getLocaleFromUrl(Astro.url)
const t = useTranslations(locale)
const otherLocale = locale === 'zh' ? 'en' : 'zh'
const switchPath = getLocalePath(Astro.url.pathname, otherLocale)
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href={locale === 'zh' ? '/' : '/en'} class="flex items-center gap-2 text-lg font-semibold">
      <span class="text-2xl">📄</span>
      <span>DocuMind</span>
    </a>

    <div class="hidden md:flex items-center gap-8 text-sm">
      <a href="#features" class="nav-link opacity-70 hover:opacity-100 transition-opacity">{t('nav.features')}</a>
      <a href="#pricing" class="nav-link opacity-70 hover:opacity-100 transition-opacity">{t('nav.pricing')}</a>
      <a href="#faq" class="nav-link opacity-70 hover:opacity-100 transition-opacity">{t('nav.help')}</a>
    </div>

    <div class="flex items-center gap-3">
      <!-- 语言切换 -->
      <a
        href={switchPath}
        class="text-xs opacity-60 hover:opacity-100 transition-opacity px-2 py-1 rounded border border-gray-300/30 dark:border-white/10"
      >
        {languages[otherLocale]}
      </a>

      <a
        href="https://app.documindx.com"
        class="hidden md:inline-block text-sm opacity-70 hover:opacity-100 transition-opacity"
      >
        {t('nav.webapp')}
      </a>
      <a
        href="#download"
        class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium rounded-full
               bg-gray-900 text-white hover:bg-gray-800
               dark:bg-white dark:text-gray-900 dark:hover:bg-gray-100
               transition-colors"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        {t('nav.download')}
      </a>

      <button
        id="menu-toggle"
        class="md:hidden p-2 -mr-2 opacity-70 hover:opacity-100"
        aria-label={t('nav.menu')}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-white/10 bg-white/80 dark:bg-gray-950/80 backdrop-blur-xl">
    <div class="px-6 py-4 flex flex-col gap-3 text-sm">
      <a href="#features" class="py-2 opacity-70 hover:opacity-100">{t('nav.features')}</a>
      <a href="#pricing" class="py-2 opacity-70 hover:opacity-100">{t('nav.pricing')}</a>
      <a href="#faq" class="py-2 opacity-70 hover:opacity-100">{t('nav.help')}</a>
      <a href="https://app.documindx.com" class="py-2 opacity-70 hover:opacity-100">{t('nav.webapp')}</a>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar')!
  const menuToggle = document.getElementById('menu-toggle')!
  const mobileMenu = document.getElementById('mobile-menu')!
  let lastScrollY = 0
  let ticking = false

  function updateNavbar() {
    const scrollY = window.scrollY
    if (scrollY > 50) {
      navbar.classList.add('bg-white/80', 'dark:bg-gray-950/80', 'backdrop-blur-xl', 'border-b', 'border-gray-200/20', 'dark:border-white/10')
    } else {
      navbar.classList.remove('bg-white/80', 'dark:bg-gray-950/80', 'backdrop-blur-xl', 'border-b', 'border-gray-200/20', 'dark:border-white/10')
    }
    if (scrollY > 300) {
      navbar.style.transform = scrollY > lastScrollY ? 'translateY(-100%)' : 'translateY(0)'
    } else {
      navbar.style.transform = 'translateY(0)'
    }
    lastScrollY = scrollY
    ticking = false
  }

  window.addEventListener('scroll', () => {
    if (!ticking) { requestAnimationFrame(updateNavbar); ticking = true }
  })

  menuToggle.addEventListener('click', () => mobileMenu.classList.toggle('hidden'))
  mobileMenu.querySelectorAll('a').forEach(link =>
    link.addEventListener('click', () => mobileMenu.classList.add('hidden'))
  )
</script>
