---
import { getLocaleFromUrl, useTranslations } from '../i18n/utils'
import { AnimatedGridBackground } from './magicui/AnimatedBeam'
import { ShimmerButton } from './magicui/ShimmerButton'
const locale = getLocaleFromUrl(Astro.url)
const t = useTranslations(locale)
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-16">
  <!-- 粒子网格背景 -->
  <AnimatedGridBackground client:load />

  <!-- 渐变光晕 -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="hero-glow absolute top-1/4 left-1/4 w-[600px] h-[600px] rounded-full bg-indigo-500/20 dark:bg-indigo-500/10 blur-[128px]"></div>
    <div class="hero-glow absolute bottom-1/3 right-1/4 w-[500px] h-[500px] rounded-full bg-purple-500/15 dark:bg-purple-500/10 blur-[128px]" style="animation-delay: -3s"></div>
    <div class="hero-glow absolute top-1/2 right-1/3 w-[300px] h-[300px] rounded-full bg-blue-400/10 dark:bg-blue-400/5 blur-[100px]" style="animation-delay: -5s"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6 py-20 flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
    <!-- 左侧文字 -->
    <div class="flex-1 text-center lg:text-left">
      <!-- 创始会员标签 -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 text-xs font-medium rounded-full
                  bg-indigo-50/80 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400
                  border border-indigo-200/50 dark:border-indigo-500/20
                  animate-fade-in-up backdrop-blur-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
        </span>
        {t('hero.badge')}
      </div>

      <!-- 标题 -->
      <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold tracking-tight leading-[1.1]
                 animate-fade-in-up" style="animation-delay: 0.1s">
        <span id="hero-title" data-text={t('hero.title')} class="block
              bg-gradient-to-b from-gray-900 to-gray-600 dark:from-white dark:to-gray-400 bg-clip-text text-transparent"></span>
      </h1>

      <!-- 副标题 -->
      <p class="mt-6 text-lg sm:text-xl text-gray-500 dark:text-gray-400 max-w-xl mx-auto lg:mx-0 leading-relaxed
                animate-fade-in-up" style="animation-delay: 0.2s">
        {t('hero.subtitle')}
      </p>

      <!-- CTA -->
      <div class="mt-10 flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start
                  animate-fade-in-up" style="animation-delay: 0.3s">
        <ShimmerButton href="#download" client:load>
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          {t('hero.cta.download')}
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </ShimmerButton>
        <a
          href="https://app.documindx.com"
          class="inline-flex items-center gap-2 px-6 py-3.5 text-base font-medium rounded-full
                 border border-gray-300/60 dark:border-gray-700 hover:border-gray-400 dark:hover:border-gray-500
                 hover:bg-gray-50 dark:hover:bg-white/5
                 transition-all duration-300"
        >
          {t('hero.cta.web')}
        </a>
      </div>
    </div>

    <!-- 右侧手机 Mockup -->
    <div class="flex-shrink-0 animate-fade-in-up" style="animation-delay: 0.4s; perspective: 1000px">
      <div id="phone-mockup" class="relative w-[280px] sm:w-[320px] transition-transform duration-200 ease-out"
           style="transform: rotateY(-5deg) rotateX(5deg)">
        <div class="relative rounded-[3rem] bg-gradient-to-b from-gray-800 to-gray-900 dark:from-gray-700 dark:to-gray-800 p-3 shadow-2xl shadow-indigo-500/10 dark:shadow-indigo-500/5">
          <div class="rounded-[2.4rem] overflow-hidden bg-gray-100 dark:bg-gray-900 aspect-[9/19.5]">
            <video
              id="hero-video"
              class="w-full h-full object-cover"
              muted
              loop
              playsinline
              preload="none"
              poster="/screenshots/hero-poster.jpg"
            >
              <source src="/screenshots/hero-demo.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
        <!-- 反射光 -->
        <div class="absolute inset-0 rounded-[3rem] bg-gradient-to-tr from-transparent via-white/10 to-transparent pointer-events-none"></div>
        <!-- 底部投影 -->
        <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 w-3/4 h-8 bg-indigo-500/10 rounded-full blur-xl"></div>
      </div>
    </div>
  </div>

  <!-- 向下滚动 -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce opacity-30">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>

<style>
  .hero-glow { animation: glow-drift 8s ease-in-out infinite alternate; }
  @keyframes glow-drift { 0% { transform: translate(0, 0) scale(1); } 100% { transform: translate(30px, -20px) scale(1.1); } }
  /* 移动端简化光晕：缩小尺寸、降低 blur */
  @media (max-width: 768px) {
    .hero-glow { width: 200px !important; height: 200px !important; filter: blur(60px); animation: none; }
  }
</style>

<script>
  // 打字机效果
  const titleEl = document.getElementById('hero-title')!
  const text = titleEl.dataset.text || ''
  let i = 0
  function typeWriter() {
    if (i < text.length) { titleEl.textContent += text.charAt(i); i++; setTimeout(typeWriter, 80) }
  }
  setTimeout(typeWriter, 600)

  // 延迟加载视频，避免阻塞首屏
  const video = document.getElementById('hero-video') as HTMLVideoElement
  if (video) {
    video.preload = 'auto'
    video.play().catch(() => {})
  }

  // 手机视差
  const mockup = document.getElementById('phone-mockup')!
  if (window.matchMedia('(min-width: 1024px)').matches) {
    document.addEventListener('mousemove', (e) => {
      const x = (e.clientX / window.innerWidth - 0.5) * 8
      const y = (e.clientY / window.innerHeight - 0.5) * 8
      mockup.style.transform = `rotateY(${-5 + x}deg) rotateX(${5 - y}deg)`
    })
  }
</script>
