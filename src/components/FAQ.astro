---
import { getLocaleFromUrl, useTranslations } from '../i18n/utils'
const locale = getLocaleFromUrl(Astro.url)
const t = useTranslations(locale)

const faqs = [
  { q: t('faq.1.q'), a: t('faq.1.a') },
  { q: t('faq.2.q'), a: t('faq.2.a') },
  { q: t('faq.3.q'), a: t('faq.3.a') },
  { q: t('faq.4.q'), a: t('faq.4.a') },
]
---

<section id="faq" class="py-24 sm:py-32">
  <div class="max-w-3xl mx-auto px-6">
    <div class="text-center mb-14">
      <p class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase tracking-widest mb-3">{t('faq.title')}</p>
      <h2 class="text-3xl sm:text-4xl font-bold reveal">
        {locale === 'zh' ? '还有疑问？' : 'Got questions?'}
      </h2>
    </div>

    <div class="faq-list space-y-2">
      {faqs.map((faq, i) => (
        <details class="faq-item group rounded-2xl bg-gray-50/50 dark:bg-white/[0.03] border border-transparent hover:border-gray-200 dark:hover:border-gray-700/50 open:border-gray-200 dark:open:border-gray-700/50 transition-all duration-300">
          <summary class="flex items-center gap-4 px-6 py-5 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
            <span class="flex-shrink-0 w-7 h-7 rounded-lg bg-gray-100 dark:bg-white/[0.06] flex items-center justify-center text-xs font-medium text-gray-400 dark:text-gray-500 tabular-nums group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="flex-1 font-medium text-[15px] text-gray-800 dark:text-gray-200">{faq.q}</span>
            <span class="flex-shrink-0 w-7 h-7 rounded-full bg-gray-100 dark:bg-white/[0.06] flex items-center justify-center group-hover:bg-gray-200 dark:group-hover:bg-white/10 transition-all duration-300">
              <svg class="w-3.5 h-3.5 text-gray-400 transition-transform duration-300 group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12M6 12h12"/>
              </svg>
            </span>
          </summary>
          <div class="faq-answer px-6 pb-5 pl-[4.25rem] text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
            {faq.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item summary:focus-visible {
    outline: 2px solid rgb(99 102 241 / 0.5);
    outline-offset: 2px;
    border-radius: 1rem;
  }
  .faq-answer {
    animation: faq-expand 0.3s ease-out;
  }
  @keyframes faq-expand {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
