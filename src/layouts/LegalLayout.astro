---
import Layout from './Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  lastUpdated: string
}

const { title, lastUpdated } = Astro.props
---

<Layout title={`${title} - DocuMindX`}>
  <Navbar />
  <main class="min-h-screen pt-32 pb-16">
    <article class="max-w-3xl mx-auto px-6">
      <header class="mb-10 text-center">
        <h1 class="text-3xl sm:text-4xl font-bold mb-3">{title}</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">{lastUpdated}</p>
      </header>
      <div class="legal-prose">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  .legal-prose {
    color: rgb(55 65 81);
    line-height: 1.8;
    font-size: 1rem;
  }
  .dark .legal-prose {
    color: rgb(229 231 235);
  }
  .legal-prose h2 {
    font-size: 1.625rem;
    font-weight: 700;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    color: rgb(17 24 39);
    border-bottom: 1px solid rgb(229 231 235);
    padding-bottom: 0.5rem;
  }
  .dark .legal-prose h2 {
    color: rgb(255 255 255);
    border-bottom-color: rgb(75 85 99);
  }
  .legal-prose h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: rgb(31 41 55);
  }
  .dark .legal-prose h3 {
    color: rgb(243 244 246);
  }
  .legal-prose p {
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .legal-prose ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 0.75rem 0;
  }
  .legal-prose li {
    margin: 0.4rem 0;
  }
  .legal-prose li::marker {
    color: rgb(107 114 128);
  }
  .dark .legal-prose li::marker {
    color: rgb(156 163 175);
  }
  .legal-prose strong {
    color: rgb(17 24 39);
    font-weight: 600;
  }
  .dark .legal-prose strong {
    color: rgb(255 255 255);
  }
  .legal-prose a {
    color: rgb(79 70 229);
    text-decoration: underline;
  }
  .dark .legal-prose a {
    color: rgb(165 180 252);
  }
  .legal-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.95rem;
  }
  .legal-prose th,
  .legal-prose td {
    border: 1px solid rgb(229 231 235);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .dark .legal-prose th,
  .dark .legal-prose td {
    border-color: rgb(75 85 99);
  }
  .legal-prose th {
    background: rgb(249 250 251);
    font-weight: 600;
  }
  .dark .legal-prose th {
    background: rgb(31 41 55);
    color: rgb(255 255 255);
  }
  .legal-prose hr {
    margin: 2rem 0;
    border: none;
    border-top: 1px solid rgb(229 231 235);
  }
  .dark .legal-prose hr {
    border-top-color: rgb(75 85 99);
  }
</style>
